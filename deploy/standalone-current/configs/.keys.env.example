# OpenViking API keys  (chmod 600, 勿提交 git)
# 在新机器上重命名为 .keys.env 并填入真实值。

# OpenViking server root / admin / viewer keys
ROOT_TEXTBOOKS=<REDACTED>
ROOT_CURRICULUM=<REDACTED>
ADMIN_TEXTBOOKS=<REDACTED>
ADMIN_CURRICULUM=<REDACTED>
VIEWER_TEXTBOOKS=<REDACTED>
VIEWER_CURRICULUM=<REDACTED>

# Bot 大模型（当前使用火山方舟 GLM-5-2）
GLM52_API_KEY=<REDACTED>
GLM52_BASE_URL=https://ark.cn-beijing.volces.com/api/plan
GLM52_MODEL=glm-5-2-260617

# Kimi 联网搜索（bot web_search 后端，agent-gw.kimi.com）
KIMI_SEARCH_API_KEY=<REDACTED>
